    &lt;div class=&quot;aspect-image&quot; style=&quot;--aspect-ratio:690/291;&quot;&gt;&lt;img src=&quot;https://cdn3.ldstatic.com/optimized/3X/1/d/1db9b22d3c461cf59d1b503b08361354637bf04f_2_690x291.jpeg&quot; class=&quot;thumbnail&quot; alt=&quot;&quot; data-dominant-color=&quot;4B3F50&quot; width=&quot;690&quot; height=&quot;291&quot;&gt;&lt;/div&gt;

