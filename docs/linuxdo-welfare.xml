    &lt;div class=&quot;quote-title__text-content&quot;&gt;
      &lt;a href=&quot;https://linux.do/t/topic/2358627&quot;&gt;Notion business 上线 fable 5, 附 启用方法&lt;/a&gt; &lt;a class=&quot;badge-category__wrapper &quot; href=&quot;https://linux.do/c/news/34&quot;&gt;&lt;span data-category-id=&quot;34&quot; style=&quot;--category-badge-color: #BB8FCE; --category-badge-text-color: #000000;&quot; data-drop-close=&quot;true&quot; class=&quot;badge-category --style-icon &quot; title=&quot;前沿快讯，不出门能知天下事。&quot;&gt;&lt;svg class=&quot;fa d-icon svg-icon svg-node&quot; aria-hidden=&quot;true&quot;&gt;&lt;svg id=&quot;newspaper&quot; viewBox=&quot;0 0 512 512&quot;&gt;
