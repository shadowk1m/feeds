            &lt;aside class=&quot;onebox allowlistedgeneric&quot; data-onebox-src=&quot;https://cdk.linux.do/receive/7164495e-24cf-4c94-8781-6b1a4c7c602a&quot;&gt;
  &lt;header class=&quot;source&quot;&gt;
      &lt;img src=&quot;https://cdn3.ldstatic.com/original/4X/a/d/c/adc529222c2e32c16e2422656015ece05df91f75.png&quot; class=&quot;site-icon&quot; alt=&quot;&quot; data-dominant-color=&quot;CBBC9B&quot; width=&quot;48&quot; height=&quot;48&quot;&gt;

      &lt;a href=&quot;https://cdk.linux.do/receive/7164495e-24cf-4c94-8781-6b1a4c7c602a&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;cdk.linux.do&lt;/a&gt;
