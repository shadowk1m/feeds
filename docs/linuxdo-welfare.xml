&lt;p&gt;&lt;img src=&quot;https://cdn.ldstatic.com/images/emoji/twemoji/wrapped_gift.png?v=15&quot; title=&quot;:wrapped_gift:&quot; class=&quot;emoji&quot; alt=&quot;:wrapped_gift:&quot; loading=&quot;lazy&quot; width=&quot;20&quot; height=&quot;20&quot;&gt; &lt;strong&gt;给佬友的专属福利&lt;/strong&gt;&lt;br&gt;
