&lt;/p&gt;&lt;div class=&quot;lightbox-wrapper&quot;&gt;&lt;a class=&quot;lightbox&quot; href=&quot;https://cdn3.ldstatic.com/original/4X/7/4/1/741334d2df0c02ffe997c0dd67dce45f07076fe3.jpeg&quot; data-download-href=&quot;/uploads/short-url/gyQxegZL5YfEFZxoU46QU24H0pJ.jpeg?dl=1&quot; title=&quot;image&quot; rel=&quot;noopener nofollow ugc&quot;&gt;&lt;img src=&quot;https://cdn3.ldstatic.com/optimized/4X/7/4/1/741334d2df0c02ffe997c0dd67dce45f07076fe3_2_690x325.jpeg&quot; alt=&quot;image&quot; data-base62-sha1=&quot;gyQxegZL5YfEFZxoU46QU24H0pJ&quot; width=&quot;690&quot; height=&quot;325&quot; srcset=&quot;https://cdn3.ldstatic.com/optimized/4X/7/4/1/741334d2df0c02ffe997c0dd67dce45f07076fe3_2_690x325.jpeg, https://cdn3.ldstatic.com/optimized/4X/7/4/1/741334d2df0c02ffe997c0dd67dce45f07076fe3_2_1035x487.jpeg 1.5x, https://cdn3.ldstatic.com/optimized/4X/7/4/1/741334d2df0c02ffe997c0dd67dce45f07076fe3_2_1380x650.jpeg 2x&quot; data-dominant-color=&quot;EEEDED&quot;&gt;&lt;/a&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;
