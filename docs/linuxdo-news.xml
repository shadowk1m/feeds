    <item>
      <title>好技术正在悄悄变便宜</title>
      <link>https://linux.do/t/topic/2275468</link>
      <guid>linux.do-topic-2275468</guid>
      <pubDate>Sat, 30 May 2026 13:44:48 GMT</pubDate>
      <description>
            &lt;p&gt;&lt;a class=&quot;attachment&quot; href=&quot;https://linux.do/uploads/short-url/3CryOKOVZLY7mTac9PicjPqZMEX.pdf&quot;&gt;好技术正在悄悄变便宜.pdf&lt;/a&gt; (1.0 MB)&lt;/p&gt;
&lt;audio controls=&quot;&quot;&gt;
  &lt;source src=&quot;https://pool-1305119010.cos.ap-nanjing.myqcloud.com/music/AI260530.m4a&quot; type=&quot;audio/mpeg&quot;&gt;
