  &lt;/header&gt;

  &lt;article class=&quot;onebox-body&quot;&gt;
    &lt;div class=&quot;aspect-image&quot; style=&quot;--aspect-ratio:690/387;&quot;&gt;&lt;img src=&quot;https://cdn3.ldstatic.com/optimized/4X/7/f/9/7f9d5fd9df587ac3ab14adb850864d02db2f05dd_2_690x388.jpeg&quot; class=&quot;thumbnail&quot; alt=&quot;&quot; data-dominant-color=&quot;5C4E4C&quot; width=&quot;690&quot; height=&quot;388&quot;&gt;&lt;/div&gt;

