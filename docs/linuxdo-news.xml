&lt;/aside&gt;
&lt;aside class=&quot;onebox allowlistedgeneric&quot; data-onebox-src=&quot;https://arxiv.org/abs/2606.04847&quot;&gt;
  &lt;header class=&quot;source&quot;&gt;
      &lt;img src=&quot;https://cdn3.ldstatic.com/original/4X/7/7/3/7737f9c766957e34da6871902e1e7a9d2aca40f3.png&quot; class=&quot;site-icon&quot; alt=&quot;&quot; data-dominant-color=&quot;B36362&quot; width=&quot;32&quot; height=&quot;32&quot;&gt;

