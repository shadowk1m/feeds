  &lt;article class=&quot;onebox-body&quot;&gt;
    &lt;div class=&quot;aspect-image&quot; style=&quot;--aspect-ratio:690/387;&quot;&gt;&lt;img src=&quot;https://cdn3.ldstatic.com/optimized/4X/7/0/9/709b0ac100d85cdff78ffbda5aaff6a47ddbccd7_2_690x388.jpeg&quot; class=&quot;thumbnail&quot; alt=&quot;&quot; data-dominant-color=&quot;708D9E&quot; width=&quot;690&quot; height=&quot;388&quot;&gt;&lt;/div&gt;

&lt;h3&gt;&lt;a href=&quot;https://www.bbc.com/news/articles/cj9ppm94xw9o&quot; target=&quot;_blank&quot; rel=&quot;noopener nofollow ugc&quot;&gt;Longview explosion: one killed and others missing after blast at paper mill&lt;/a&gt;&lt;/h3&gt;

